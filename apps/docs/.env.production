# Production-only env for the docs build.
#
# Next.js loads this file ONLY for production builds (`next build`, which Ploy
# runs on deploy) and NEVER for `next dev` — so local dev keeps falling back to
# the code defaults in app/layout.config.tsx.
#
# These values used to live in the `env:` block of apps/docs/ploy.yaml, which
# Ploy no longer supports. A real env var set in the Ploy project settings
# overrides this file at build time.

NEXT_PUBLIC_DASHBOARD_URL=https://app.clankersupport.com
NEXT_PUBLIC_MARKETING_URL=https://clankersupport.com
