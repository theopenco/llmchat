# Production-only env for the dashboard build.
#
# Next.js loads this file ONLY for production builds (`next build`, which Ploy
# runs on deploy) and NEVER for `next dev` — so local dev keeps falling back to
# the code defaults / apps/dashboard/.env.
#
# These values used to live in the `env:` block of apps/dashboard/ploy.yaml,
# which Ploy no longer supports. A real env var set in the Ploy project
# settings overrides this file at build time.
#
# NEXT_PUBLIC_* is baked into the browser bundle — PUBLIC values only, never a
# secret. NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is deliberately NOT committed here
# (it differs per environment); set it in the Ploy project settings.

# Origin of the API / Better Auth server the dashboard calls.
NEXT_PUBLIC_API_URL=https://api.clankersupport.com

# Analytics (PostHog EU). Public/write-only project key — safe to commit, same
# convention as apps/showcase/.env.production.
NEXT_PUBLIC_POSTHOG_KEY=phc_ySVKqGDizuGXPiHXYLVnUXMnR28FNZu8PccWLt6BdbfH
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
