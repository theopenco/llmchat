# Production-only env for the admin build.
#
# Next.js loads this file ONLY for production builds (`next build`, which Ploy
# runs on deploy) and NEVER for `next dev` — so local dev keeps falling back to
# the code default in src/lib/api-base.ts.
#
# These values used to live in the `env:` block of apps/admin/ploy.yaml, which
# Ploy no longer supports. A real env var set in the Ploy project settings
# overrides this file at build time.

# Origin of the API / Better Auth server the console calls.
NEXT_PUBLIC_API_URL=https://api.clankersupport.com
